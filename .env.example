# ========================================
# Core Settings
# ========================================

# Environment: development | production
NODE_ENV=development

# Dry run mode: true (no API calls) | false (real API calls)
DRY_RUN=false

# Web Server Configuration
PORT=3000
WEB_CORS_ORIGIN=*

# Logging Configuration
# Levels: debug | info | warn | error
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE_ENABLED=true
LOG_FILE=logs/app.log

# ========================================
# Adapter Configuration
# ========================================

# Adapter selection: MOCK | YOUTUBE
CHAT_ADAPTER=MOCK

# Mock Adapter Settings
MOCK_FILE_PATH=./mocks/replay.json
MOCK_POLLING_INTERVAL=1000
MOCK_TTS_PREVIEW_LENGTH=50

# YouTube Adapter Settings
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
YOUTUBE_VIDEO_ID=YOUR_VIDEO_ID
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_POLLING_INTERVAL=1000
YOUTUBE_BACKOFF_INITIAL_MS=1000
YOUTUBE_BACKOFF_MAX_MS=60000
YOUTUBE_SEEN_ID_LIMIT=5000
YOUTUBE_LIVE_BROADCAST_MAX_RESULTS=1

# ========================================
# Agent Behavior
# ========================================

# Tick Interval (Main Loop)
AGENT_TICK_INTERVAL_MS=1000

# Comment Handling
AGENT_RECENT_COMMENT_LIMIT=20
AGENT_SHORT_COMMENT_LENGTH=3
AGENT_ERROR_COOLDOWN_MS=10000

# Monologue (Self-initiated speech)
AGENT_MONOLOGUE_INTERVAL_MS=10000
AGENT_MONOLOGUE_VARIANCE_MS=3000
AGENT_MONOLOGUE_MIN_INTERVAL_MS=1000

# Speech timing
AGENT_PRESPEECH_DELAY_MIN_MS=500
AGENT_PRESPEECH_DELAY_MAX_MS=2000
AGENT_SPEECH_FALLBACK_MIN_MS=1200
AGENT_SPEECH_PER_CHAR_MS=90

# Memory System Weights
AGENT_MEMORY_CONSOLIDATION_LIMIT=100
AGENT_MEMORY_CONSOLIDATION_TEMPERATURE=0.3
AGENT_MEMORY_CONSOLIDATION_MAX_TOKENS=500
AGENT_MEMORY_IMPORTANCE_CHANGE_REQ=8
AGENT_MEMORY_IMPORTANCE_ON_TOPIC=6

# ========================================
# Emotion Engine
# ========================================

# Decay and History
EMOTION_DECAY=0.6
EMOTION_HISTORY_WEIGHT=0.2
EMOTION_HISTORY_CONTEXT_WINDOW=2
EMOTION_HISTORY_SCORE_WINDOW=3

# Mood Clamps
EMOTION_MOOD_MIN=-2
EMOTION_MOOD_MAX=2

# Dynamics
EMOTION_EXCITEMENT_BOOST=0.4
EMOTION_ANGER_PENALTY=0.4
EMOTION_SIGNAL_CLAMP_MAX=2

# Thresholds for state changes
EMOTION_ANGRY_MOOD_MAX=-0.6
EMOTION_EXCITED_MOOD_MIN=1.0
EMOTION_HAPPY_MOOD_MIN=0.4
EMOTION_SAD_MOOD_MAX=-0.8

# Default lock duration
EMOTION_LOCK_DEFAULT_MS=30000

# ========================================
# Storytelling Service
# ========================================

STORY_THEME_DEFAULT=雑談
STORY_THEME_LOCK_MS=120000
STORY_THEME_TOKEN_PICK_LIMIT=2

# Cooldowns
STORY_TWIST_COOLDOWN_MS=120000
STORY_SUMMARY_COOLDOWN_MS=180000
STORY_EMOTION_COOLDOWN_MS=45000

# Golden Thread
STORY_GOLDEN_SCORE_THRESHOLD=4
STORY_GOLDEN_FORCE_THRESHOLD=6

# Vibe & Trend
STORY_VIBE_SIGNAL_THRESHOLD=2
STORY_TREND_DECAY=0.98

# ========================================
# Prompts & LLM
# ========================================

# LLM Provider Selection
# Options: 'openai' | 'grok' | 'groq'
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=1
OPENAI_MAX_TOKENS=1024
OPENAI_BASE_URL=

# xAI (Grok) Configuration
GROK_API_KEY=YOUR_XAI_API_KEY
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-beta
GROK_TEMPERATURE=0.7
GROK_MAX_TOKENS=1024

# Groq Configuration
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama3-70b-8192
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1024

# Prompt Specific Settings
PROMPT_REPLY_TEMPERATURE=0.6
PROMPT_REPLY_MAX_TOKENS=2048
PROMPT_MONOLOGUE_TEMPERATURE=0.7
PROMPT_MONOLOGUE_MAX_TOKENS=2048
PROMPT_NARRATIVE_TEMPERATURE=0.7
PROMPT_NARRATIVE_MAX_TOKENS=400
PROMPT_NARRATIVE_RECENT_LIMIT=6
PROMPT_MEMORY_RELEVANCE_THRESHOLD=0.7
PROMPT_MEMORY_MAX_STARS=5

# ========================================
# External Services
# ========================================

# Prisma Database
DATABASE_URL="file:./dev.db"

# ChromaDB (Vector Database)
CHROMA_URL=http://localhost:8000
MEMORY_COLLECTION_NAME=ai_vtuber_memories
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_DEFAULT_IMPORTANCE=5
MEMORY_SEARCH_LIMIT=5
MEMORY_STREAM_LIMIT=10
MEMORY_VIEWER_LIMIT=10

# VOICEVOX (TTS)
VOICEVOX_BASE_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=1
VOICEVOX_TIMEOUT_MS=15000

# VTube Studio Integration
VTS_ENABLED=false
VTS_HOST=localhost
VTS_PORT=8001
VTS_PLUGIN_NAME=AI-VTuber
VTS_PLUGIN_DEVELOPER=AI-VTuber Developer
VTS_AUTH_TOKEN=
VTS_LIPSYNC_PARAM_ID=MouthOpen
VTS_LIPSYNC_FRAME_MS=16
VTS_VOLUME_SCALE=1.5
VTS_LIPSYNC_SMOOTHING=0.3
VTS_LIPSYNC_FINAL_DELAY_MS=100
VTS_MAX_RECONNECT_ATTEMPTS=5

# VTS Hotkeys (IDs)
VTS_HOTKEY_NEUTRAL=
VTS_HOTKEY_HAPPY=
VTS_HOTKEY_SAD=
VTS_HOTKEY_ANGRY=
VTS_HOTKEY_EXCITED=

# OBS Studio Integration
OBS_ENABLED=false
OBS_HOST=127.0.0.1
OBS_PORT=4455
OBS_WS_PASSWORD=

# OBS Scenes
OBS_SCENE_MAIN=Main
OBS_SCENE_WAITING=Waiting
OBS_SCENE_ENDING=Ending

# Volume Analyzer
VOLUME_FRAME_MS=16
VOLUME_RMS_SCALE=2.0
